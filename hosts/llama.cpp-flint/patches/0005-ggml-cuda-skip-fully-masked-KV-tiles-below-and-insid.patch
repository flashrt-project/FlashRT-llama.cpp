From 02064a15bf819a4ddb9af194d4c88dfa28b48cf2 Mon Sep 17 00:00:00 2001
From: LiangSu8899 <7thuniversels@gmail.com>
Date: Wed, 21 Oct 2026 20:12:36 -0400
Subject: [PATCH 5/7] ggml-cuda: skip fully masked KV tiles below and inside
 the window (MMA FA)

For large query batches the mask is already scanned for an upper KV bound.
A second scan now records, per query tile, the first non-masked KV chunk
and (for short caches, n_kv <= 2*n_q, i.e. sliding-window rings) the
largest fully masked run between non-masked chunks. The tensor-core kernel
starts at the lower bound and jumps over that run inside each block's
unchanged stream-k range; masked tiles leave the softmax state unchanged,
so results are bit-identical. Sliding-window prefill attention no longer
scans the whole ring per query tile. GGML_CUDA_FA_KV_MIN=0 disables it.
Prefill logits bit-identical (8192 tokens, ubatch 2048); pp4K..32K +4%.

---
 ggml/src/ggml-cuda/fattn-common.cuh  | 89 +++++++++++++++++++++++++++-
 ggml/src/ggml-cuda/fattn-mma-f16.cuh | 77 ++++++++++++++++++------
 2 files changed, 146 insertions(+), 20 deletions(-)

diff --git a/ggml/src/ggml-cuda/fattn-common.cuh b/ggml/src/ggml-cuda/fattn-common.cuh
index 41d9483..98ecf26 100644
--- a/ggml/src/ggml-cuda/fattn-common.cuh
+++ b/ggml/src/ggml-cuda/fattn-common.cuh
@@ -723,6 +723,80 @@ static __global__ void flash_attn_mask_to_KV_max(
     KV_max[sequence*ne31 + jt] = KV_max_sj;
 }
 
+// Lower-bound counterpart of flash_attn_mask_to_KV_max for the tile of ncols1 queries, in columns:
+// [0] start of the first FATTN_KQ_STRIDE chunk with a non-masked value (ne30*FATTN_KQ_STRIDE if none),
+// [1, 2) the largest fully masked run of chunks between non-masked ones (full_scan only, else empty).
+// A sliding-window cache in a ring buffer leaves most cells masked, below the window or, once the
+// window wraps around the ring, in the middle. Stored after the KV_max values; bit 0 of the tile's
+// KV_max (otherwise a multiple of FATTN_KQ_STRIDE) signals their presence.
+template <int ncols1>
+__launch_bounds__(FATTN_KQ_STRIDE/2, 1)
+static __global__ void flash_attn_mask_to_KV_min(
+        const half2 * mask_ptr, int * KV_max_ptr, const int ne30, const int64_t s31, const int64_t s33, const bool full_scan) {
+    const half2 * GGML_CUDA_RESTRICT mask   = mask_ptr;
+    int         * GGML_CUDA_RESTRICT KV_max = KV_max_ptr;
+
+    const int ne31     = gridDim.x;
+    const int tid      = threadIdx.x;
+    const int sequence = blockIdx.y;
+    const int jt       = blockIdx.x;
+
+    mask += sequence*s33 + jt*ncols1*s31;
+
+    __shared__ int buf_iw[WARP_SIZE];
+    if (tid < WARP_SIZE) {
+        buf_iw[tid] = 1;
+    }
+    ggml_cuda_pdl_sync();
+    __syncthreads();
+
+    int KV_min_sj = -1, prev_live = -1, gap_lo = 0, gap_hi = 0;
+    for (int sj = 0; sj < ne30*FATTN_KQ_STRIDE; sj += FATTN_KQ_STRIDE) {
+        int all_inf = 1;
+
+#pragma unroll
+        for (int j = 0; j < ncols1; ++j) {
+            const float2 tmp = __half22float2(mask[j*s31 + sj/2 + tid]);
+            all_inf = all_inf && int(isinf(tmp.x)) && int(isinf(tmp.y));
+        }
+
+        all_inf = warp_reduce_all(all_inf);
+        if (tid % WARP_SIZE == 0) {
+            buf_iw[tid / WARP_SIZE] = all_inf;
+        }
+        __syncthreads();
+        all_inf = buf_iw[tid % WARP_SIZE];
+        __syncthreads();
+        all_inf = warp_reduce_all(all_inf);
+
+        if (!all_inf) {
+            if (KV_min_sj < 0) {
+                KV_min_sj = sj;
+                if (!full_scan) {
+                    break;
+                }
+            } else if (sj - prev_live > FATTN_KQ_STRIDE + (gap_hi - gap_lo)) {
+                gap_lo = prev_live + FATTN_KQ_STRIDE;
+                gap_hi = sj;
+            }
+            prev_live = sj;
+        }
+    }
+    if (KV_min_sj < 0) {
+        KV_min_sj = ne30*FATTN_KQ_STRIDE;
+    }
+
+    if (threadIdx.x != 0) {
+        return;
+    }
+
+    int * out = KV_max + gridDim.y*ne31 + 3*(sequence*ne31 + jt);
+    out[0] = KV_min_sj;
+    out[1] = gap_lo;
+    out[2] = gap_hi;
+    KV_max[sequence*ne31 + jt] |= 1;
+}
+
 void ggml_cuda_flash_attn_ext_compact_mask(
         const ggml_tensor * mask, int32_t * indices, int32_t * counts, int32_t n_queries, int32_t ncols1, int32_t n_kv_max, cudaStream_t stream);
 
@@ -981,7 +1055,7 @@ template <int DV, int ncols1, int ncols2>
 void launch_fattn(
     ggml_backend_cuda_context & ctx, ggml_tensor * dst, fattn_kernel_t fattn_kernel, const int nwarps, const size_t nbytes_shared,
     const int nbatch_fa, const bool need_f16_K, const bool need_f16_V, const bool stream_k, const bool use_sparse,
-    const int warp_size = WARP_SIZE, const bool async_kv_preload = false
+    const int warp_size = WARP_SIZE, const bool async_kv_preload = false, const bool kv_min_ok = false
 ) {
     constexpr int ncols = ncols1 * ncols2;
 
@@ -1125,11 +1199,22 @@ void launch_fattn(
         const int ne_KV_max = blocks_num_KV_max.x*blocks_num_KV_max.y;
         const int iter_k = K->ne[1] / FATTN_KQ_STRIDE;
 
-        KV_max.alloc(ne_KV_max);
+        // the lower bound is only understood by the tensor-core kernel (GGML_CUDA_FA_KV_MIN=0: off)
+        static const bool kv_min_env = !(getenv("GGML_CUDA_FA_KV_MIN") && atoi(getenv("GGML_CUDA_FA_KV_MIN")) == 0);
+        const bool use_kv_min = kv_min_ok && kv_min_env;
+
+        KV_max.alloc(use_kv_min ? 4*ne_KV_max : ne_KV_max);
         ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(blocks_num_KV_max, block_dim_KV_max, 0, main_stream);
         ggml_cuda_kernel_launch(flash_attn_mask_to_KV_max<ncols1>, launch_params,
             (const half2 *) mask->data, KV_max.ptr, iter_k, s31, s33);
         CUDA_CHECK(cudaGetLastError());
+        if (use_kv_min) {
+            // the interior scan reads the whole mask: only for short caches (sliding-window rings)
+            const bool full_scan = K->ne[1] <= 2*Q->ne[1];
+            ggml_cuda_kernel_launch(flash_attn_mask_to_KV_min<ncols1>, launch_params,
+                (const half2 *) mask->data, KV_max.ptr, iter_k, s31, s33, full_scan);
+            CUDA_CHECK(cudaGetLastError());
+        }
     }
 
     const dim3 block_dim(warp_size, nwarps, 1);
