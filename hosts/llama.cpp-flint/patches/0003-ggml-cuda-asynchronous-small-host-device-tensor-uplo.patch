From 2ceb62742a4cfb1eeaf180571f9f665fc9841317 Mon Sep 17 00:00:00 2001
From: LiangSu8899 <7thuniversels@gmail.com>
Date: Wed, 21 Oct 2026 19:22:51 -0400
Subject: [PATCH 3/8] ggml-cuda: asynchronous small host->device tensor uploads

set_tensor of <= 64 KiB no longer blocks: the source is copied into a
pinned staging ring, so the caller may reuse its buffer at once (graph
inputs often live in pinned host memory, which cudaMemcpyAsync does not
stage), and the copy is issued on a per-device upload stream with an event
recorded after it. Graph compute, the backend async copies and every
blocking access to device memory wait on that event. Per-token graph inputs
(token, positions, masks, cache indices) were 14 blocking round trips per
decode step. GGML_CUDA_SYNC_UPLOADS=1 restores the blocking behaviour.

---
 ggml/src/ggml-cuda/ggml-cuda.cu | 71 +++++++++++++++++++++++++++++++++
 1 file changed, 71 insertions(+)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 8c7f44e..e36c78c 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -832,10 +832,46 @@ static enum ggml_status ggml_backend_cuda_buffer_init_tensor(ggml_backend_buffer
     return GGML_STATUS_SUCCESS;
 }
 
+// Small host -> device uploads (per-token graph inputs) are asynchronous: the
+// source is copied into a pinned staging ring, so the caller may reuse its
+// buffer at once whether it is pageable or pinned, and the copy is issued on
+// a per-device upload stream. Every later reader or writer of device memory
+// waits on the event recorded after the last upload instead of the host
+// blocking once per tensor. GGML_CUDA_SYNC_UPLOADS=1 restores the blocking
+// behaviour.
+struct ggml_cuda_upload_state {
+    std::mutex   mutex;
+    cudaStream_t stream = nullptr;
+    cudaEvent_t  event  = nullptr;   // recorded after the last upload
+    char *       ring   = nullptr;   // pinned staging
+    size_t       head   = 0;
+};
+static ggml_cuda_upload_state ggml_cuda_uploads[GGML_CUDA_MAX_DEVICES];
+static constexpr size_t GGML_CUDA_ASYNC_UPLOAD_MAX = 64*1024;
+static constexpr size_t GGML_CUDA_UPLOAD_RING_SIZE = 1024*1024;
+
+static bool ggml_cuda_async_uploads_enabled() {
+    static const bool enabled = [] {
+        const char * env = getenv("GGML_CUDA_SYNC_UPLOADS");
+        return !(env && atoi(env) != 0);
+    }();
+    return enabled;
+}
+
+// make `stream` wait for the async uploads issued so far to `device`
+static void ggml_cuda_uploads_wait(int device, cudaStream_t stream) {
+    ggml_cuda_upload_state & u = ggml_cuda_uploads[device];
+    std::lock_guard<std::mutex> lock(u.mutex);
+    if (u.event != nullptr) {
+        CUDA_CHECK(cudaStreamWaitEvent(stream, u.event, 0));
+    }
+}
+
 static void ggml_backend_cuda_buffer_memset_tensor(ggml_backend_buffer_t buffer, ggml_tensor * tensor, uint8_t value, size_t offset, size_t size) {
     ggml_backend_cuda_buffer_context * ctx = (ggml_backend_cuda_buffer_context *) buffer->context;
 
     ggml_cuda_set_device(ctx->device);
+    ggml_cuda_uploads_wait(ctx->device, cudaStreamPerThread);
     CUDA_CHECK(cudaMemsetAsync((char *) tensor->data + offset, value, size, cudaStreamPerThread));
     CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
 }
@@ -844,6 +880,27 @@ static void ggml_backend_cuda_buffer_set_tensor(ggml_backend_buffer_t buffer, gg
     ggml_backend_cuda_buffer_context * ctx = (ggml_backend_cuda_buffer_context *) buffer->context;
 
     ggml_cuda_set_device(ctx->device);
+    if (size <= GGML_CUDA_ASYNC_UPLOAD_MAX && ggml_cuda_async_uploads_enabled()) {
+        ggml_cuda_upload_state & u = ggml_cuda_uploads[ctx->device];
+        std::lock_guard<std::mutex> lock(u.mutex);
+        if (u.ring == nullptr) {
+            CUDA_CHECK(cudaStreamCreateWithFlags(&u.stream, cudaStreamNonBlocking));
+            CUDA_CHECK(cudaEventCreateWithFlags(&u.event, cudaEventDisableTiming));
+            CUDA_CHECK(cudaMallocHost(&u.ring, GGML_CUDA_UPLOAD_RING_SIZE));
+        }
+        if (u.head + size > GGML_CUDA_UPLOAD_RING_SIZE) {
+            // the copies still reading the start of the ring finish before it is reused
+            CUDA_CHECK(cudaStreamSynchronize(u.stream));
+            u.head = 0;
+        }
+        char * staged = u.ring + u.head;
+        u.head += GGML_PAD(size, 256);
+        memcpy(staged, data, size);
+        CUDA_CHECK(cudaMemcpyAsync((char *) tensor->data + offset, staged, size, cudaMemcpyHostToDevice, u.stream));
+        CUDA_CHECK(cudaEventRecord(u.event, u.stream));
+        return;
+    }
+    ggml_cuda_uploads_wait(ctx->device, cudaStreamPerThread);
     CUDA_CHECK(cudaMemcpyAsync((char *) tensor->data + offset, data, size, cudaMemcpyHostToDevice, cudaStreamPerThread));
     CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
 }
@@ -852,6 +909,7 @@ static void ggml_backend_cuda_buffer_get_tensor(ggml_backend_buffer_t buffer, co
     ggml_backend_cuda_buffer_context * ctx = (ggml_backend_cuda_buffer_context *) buffer->context;
 
     ggml_cuda_set_device(ctx->device);
+    ggml_cuda_uploads_wait(ctx->device, cudaStreamPerThread);
     CUDA_CHECK(cudaMemcpyAsync(data, (const char *) tensor->data + offset, size, cudaMemcpyDeviceToHost, cudaStreamPerThread));
     CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
 }
@@ -861,6 +919,7 @@ static void ggml_backend_cuda_buffer_set_tensor_2d(ggml_backend_buffer_t buffer,
     ggml_backend_cuda_buffer_context * ctx = (ggml_backend_cuda_buffer_context *) buffer->context;
 
     ggml_cuda_set_device(ctx->device);
+    ggml_cuda_uploads_wait(ctx->device, cudaStreamPerThread);
     CUDA_CHECK(cudaMemcpy2DAsync(
         (char *) tensor->data + offset, stride_tensor, data, stride_data, size, n_copies, cudaMemcpyHostToDevice, cudaStreamPerThread));
     CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
@@ -871,6 +930,7 @@ static void ggml_backend_cuda_buffer_get_tensor_2d(ggml_backend_buffer_t buffer,
     ggml_backend_cuda_buffer_context * ctx = (ggml_backend_cuda_buffer_context *)buffer->context;
 
     ggml_cuda_set_device(ctx->device);
+    ggml_cuda_uploads_wait(ctx->device, cudaStreamPerThread);
     CUDA_CHECK(cudaMemcpy2DAsync(
         data, stride_data, (const char *) tensor->data + offset, stride_tensor, size, n_copies, cudaMemcpyDeviceToHost, cudaStreamPerThread));
     CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
@@ -884,6 +944,10 @@ static bool ggml_backend_cuda_buffer_cpy_tensor(ggml_backend_buffer_t buffer, co
         // in which case a same-device copy (not a peer copy) is required
         const int src_physical = ggml_cuda_get_physical_device(src_ctx->device);
         const int dst_physical = ggml_cuda_get_physical_device(dst_ctx->device);
+        ggml_cuda_uploads_wait(src_ctx->device, cudaStreamPerThread);
+        if (dst_ctx->device != src_ctx->device) {
+            ggml_cuda_uploads_wait(dst_ctx->device, cudaStreamPerThread);
+        }
         if (src_physical == dst_physical) {
             CUDA_CHECK(cudaMemcpyAsync(dst->data, src->data, ggml_nbytes(src), cudaMemcpyDeviceToDevice, cudaStreamPerThread));
         } else {
@@ -905,6 +969,7 @@ static void ggml_backend_cuda_buffer_clear(ggml_backend_buffer_t buffer, uint8_t
     ggml_backend_cuda_buffer_context * ctx = (ggml_backend_cuda_buffer_context *)buffer->context;
 
     ggml_cuda_set_device(ctx->device);
+    ggml_cuda_uploads_wait(ctx->device, cudaStreamPerThread);
     CUDA_CHECK(cudaMemsetAsync(ctx->dev_ptr, value, buffer->size, cudaStreamPerThread));
     CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
 }
@@ -2605,6 +2670,7 @@ static void ggml_backend_cuda_set_tensor_async(ggml_backend_t backend, ggml_tens
     ggml_backend_buffer_t buf = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
 
     GGML_ASSERT(buf->buft == ggml_backend_cuda_buffer_type(cuda_ctx->device) && "unsupported buffer type");
+    ggml_cuda_uploads_wait(cuda_ctx->device, cuda_ctx->stream());
 
     CUDA_CHECK(cudaMemcpyAsync((char *) tensor->data + offset, data, size, cudaMemcpyHostToDevice, cuda_ctx->stream()));
 }
@@ -2614,6 +2680,7 @@ static void ggml_backend_cuda_get_tensor_async(ggml_backend_t backend, const ggm
     ggml_backend_buffer_t buf = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
 
     GGML_ASSERT(buf->buft == ggml_backend_cuda_buffer_type(cuda_ctx->device) && "unsupported buffer type");
+    ggml_cuda_uploads_wait(cuda_ctx->device, cuda_ctx->stream());
 
     CUDA_CHECK(cudaMemcpyAsync(data, (const char *) tensor->data + offset, size, cudaMemcpyDeviceToHost, cuda_ctx->stream()));
 }
@@ -2624,6 +2691,7 @@ static void ggml_backend_cuda_set_tensor_2d_async(ggml_backend_t backend, struct
     ggml_backend_buffer_t buf = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
 
     GGML_ASSERT(buf->buft == ggml_backend_cuda_buffer_type(cuda_ctx->device) && "unsupported buffer type");
+    ggml_cuda_uploads_wait(cuda_ctx->device, cuda_ctx->stream());
 
     CUDA_CHECK(cudaMemcpy2DAsync(
         (char *) tensor->data + offset, stride_tensor, data, stride_data, size, n_copies, cudaMemcpyHostToDevice, cuda_ctx->stream()));
@@ -2635,6 +2703,7 @@ static void ggml_backend_cuda_get_tensor_2d_async(ggml_backend_t backend, const
     ggml_backend_buffer_t buf = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
 
     GGML_ASSERT(buf->buft == ggml_backend_cuda_buffer_type(cuda_ctx->device) && "unsupported buffer type");
+    ggml_cuda_uploads_wait(cuda_ctx->device, cuda_ctx->stream());
 
     CUDA_CHECK(cudaMemcpy2DAsync(
         data, stride_data, (const char *) tensor->data + offset, stride_tensor, size, n_copies, cudaMemcpyDeviceToHost, cuda_ctx->stream()));
@@ -2655,6 +2724,7 @@ static bool ggml_backend_cuda_cpy_tensor_async(ggml_backend_t backend_src, ggml_
     // device -> device copy
     ggml_backend_cuda_context * cuda_ctx_src = (ggml_backend_cuda_context *) backend_src->context;
     ggml_backend_cuda_context * cuda_ctx_dst = (ggml_backend_cuda_context *) backend_dst->context;
+    ggml_cuda_uploads_wait(cuda_ctx_src->device, cuda_ctx_src->stream());
 
     ggml_backend_cuda_buffer_context * buf_ctx_src = (ggml_backend_cuda_buffer_context *) buf_src->context;
     ggml_backend_cuda_buffer_context * buf_ctx_dst = (ggml_backend_cuda_buffer_context *) buf_dst->context;
@@ -4824,6 +4894,7 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
     ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
 
     ggml_cuda_set_device(cuda_ctx->device);
+    ggml_cuda_uploads_wait(cuda_ctx->device, cuda_ctx->stream());   // before any capture can begin
 
 #ifdef GGML_CUDA_FLASHRT_SM120
     ggml_cuda_frt_prepare(*cuda_ctx, cgraph);   // eager-only setup, before any capture can begin
