 ggml/src/ggml-cuda/CMakeLists.txt | 19 +++++++
 ggml/src/ggml-cuda/ggml-cuda.cu   | 92 +++++++++++++++++++++++++++++++
 src/llama-context.cpp             | 84 ++++++++++++++++++++++------
 src/llama-context.h               | 22 ++++++++
 src/llama-quant.cpp               |  1 +
 tests/test-backend-ops.cpp        | 16 ++++++
 tools/quantize/quantize.cpp       |  1 +
 7 files changed, 217 insertions(+), 18 deletions(-)

